    ],
    "description": "YCSTS live status badge with pulsing dot"
  },
  "YCSTS Alert Banner": {
    "prefix": "yc-alert",
    "body": [
      "<div class=\"alert alert-${1|primary,success,warning,danger,info|}\">",
      "\t<div class=\"alert-icon\">",
      "\t\t<svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>",
      "\t</div>",
      "\t<div class=\"alert-content\">",
      "\t\t<div class=\"alert-title font-semibold\">${2:Notice}</div>",
      "\t\t<div class=\"alert-message text-sm\">${3:Your changes have been saved successfully.}</div>",
      "\t</div>",
      "</div>"
    ],
    "description": "YCSTS alert banner component"
  },
  "YCSTS Toast Notification": {
    "prefix": "yc-toast",
    "body": [
      "<div class=\"toast toast-top-right\">",
      "\t<div class=\"toast-card card p-4 shadow-xl border border-zinc-800 flex items-center gap-3\">",
      "\t\t<span class=\"w-2.5 h-2.5 rounded-full bg-blue-500\"></span>",
      "\t\t<span class=\"text-sm text-zinc-200\">${1:System updated to version 1.4.0}</span>",
      "\t</div>",
      "</div>"
    ],
    "description": "YCSTS toast notification container"
  },
  "YCSTS Accordion": {
    "prefix": "yc-accordion",
    "body": [
      "<details class=\"accordion-item card p-4\">",
      "\t<summary class=\"cursor-pointer font-semibold text-zinc-200 flex justify-between items-center\">",
      "\t\t<span>${1:Accordion Header}</span>",
      "\t\t<span class=\"accordion-arrow\">&darr;</span>",
      "\t</summary>",
      "\t<div class=\"accordion-content mt-3 text-sm text-zinc-400\">",
      "\t\t${2:Expanded content information goes here.}",
      "\t</div>",
      "</details>"
    ],
    "description": "YCSTS pure CSS accordion details element"
  },
  "YCSTS Floating Label Input": {
    "prefix": "yc-input-floating",
    "body": [
      "<div class=\"relative\">",
      "\t<input type=\"${1:text}\" id=\"${2:input-id}\" placeholder=\" \" class=\"input pt-6 pb-2 text-sm peer w-full\">",
      "\t<label for=\"${2:input-id}\" class=\"absolute text-xs text-zinc-500 duration-150 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-3 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-blue-500\">",
      "\t\t${3:Label Text}",
      "\t</label>",
      "</div>"
    ],
    "description": "YCSTS modern floating label input group"
  },
  "YCSTS Chat Bubble": {
    "prefix": "yc-chat-bubble",
    "body": [
      "<div class=\"chat-bubble ${1|chat-bubble-start,chat-bubble-end|}\">",
      "\t<p class=\"text-sm\">${2:Message text goes here.}</p>",
      "\t<span class=\"text-[10px] text-zinc-400 block mt-1\">${3:12:45 PM}</span>",
      "</div>"
    ],
    "description": "YCSTS chat messaging speech bubble"
  },
  "YCSTS Laravel Blade Vite Directive": {
    "prefix": "yc-laravel-vite",
    "body": [
      "@vite(['resources/css/app.css', 'resources/js/app.js'])"
    ],
    "description": "Laravel Vite directive linking YCSTS and JS assets"
  },
  "YCSTS Laravel Blade Starter": {
    "prefix": "yc-blade-starter",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"{{ str_replace('_', '-', app()->getLocale()) }}\">",
      "<head>",
      "\t<meta charset=\"utf-8\">",
      "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
      "\t<title>${1:Laravel + YCSTS}</title>",
      "\t@vite(['resources/css/app.css', 'resources/js/app.js'])",
      "</head>",
      "<body class=\"bg-zinc-950 text-zinc-100 font-sans min-h-screen p-8 selection-glow\">",
      "\t<main class=\"max-w-4xl mx-auto space-y-6 fadein\">",
      "\t\t<header class=\"card-glass p-8 text-center\">",
      "\t\t\t<h1 class=\"text-4xl font-extrabold text-gradient-primary\">${2:Built with YCSTS}</h1>",
      "\t\t\t<p class=\"mt-3 text-zinc-400\">${3:Single-word entrance animations and luxury components in Laravel.}</p>",
      "\t\t\t<div class=\"mt-6 flex justify-center gap-3\">",
      "\t\t\t\t<button class=\"btn btn-primary\">${4:Primary Action}</button>",
      "\t\t\t\t<button class=\"btn btn-secondary\">${5:Secondary Action}</button>",
      "\t\t\t</div>",
      "\t\t</header>",
      "\t\t$0",
      "\t</main>",
      "</body>",
      "</html>"
    ],
    "description": "Complete Laravel Blade starter layout with YCSTS and Vite"
  },
  "YCSTS CSS Import in app.css": {
    "prefix": "yc-import",
    "body": [
      "@import \"ycsts-framework/dist/ycsts.min.css\";"
    ],
    "description": "Import YCSTS minified CSS into CSS stylesheet"
  },
  "YCSTS Bundler Import": {
    "prefix": "yc-import-bundler",
    "body": [
      "@import \"ycsts-framework\";"
    ],
    "description": "Vite/Webpack direct bundle import for YCSTS"
  }
}
