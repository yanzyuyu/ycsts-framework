  },
  "YCSTS Modal Dialog": {
    "prefix": "yc-modal",
    "body": [
      "<div class=\"modal-overlay\" id=\"${1:modal-id}\">",
      "\t<div class=\"modal\">",
      "\t\t<div class=\"modal-header\">",
      "\t\t\t<h3 class=\"text-lg font-semibold text-zinc-100\">${2:Modal Title}</h3>",
      "\t\t\t<button type=\"button\" class=\"modal-close\">&times;</button>",
      "\t\t</div>",
      "\t\t<div class=\"modal-body\">",
      "\t\t\t<p class=\"text-zinc-400\">${3:Modal content text goes here.}</p>",
      "\t\t</div>",
      "\t\t<div class=\"modal-footer\">",
      "\t\t\t<button type=\"button\" class=\"btn btn-secondary\">Cancel</button>",
      "\t\t\t<button type=\"button\" class=\"btn btn-primary\">Confirm</button>",
      "\t\t</div>",
      "\t</div>",
      "</div>"
    ],
    "description": "YCSTS modal dialog with backdrop and header/body/footer"
  },
  "YCSTS Standard Card": {
    "prefix": "yc-card",
    "body": [
      "<div class=\"card p-${1:6}\">",
      "\t<h3 class=\"text-xl font-bold text-zinc-100\">${2:Card Title}</h3>",
      "\t<p class=\"mt-2 text-zinc-400 text-sm\">${3:Card description and details.}</p>",
      "\t$0",
      "</div>"
    ],
    "description": "YCSTS standard elevated card"
  },
  "YCSTS Glassmorphism Card": {
    "prefix": "yc-card-glass",
    "body": [
      "<div class=\"card-glass p-${1:6}\">",
      "\t<h3 class=\"text-xl font-bold text-zinc-100\">${2:Glass Card}</h3>",
      "\t<p class=\"mt-2 text-zinc-300 text-sm\">${3:Frosted glass card with backdrop blur.}</p>",
      "\t$0",
      "</div>"
    ],
    "description": "YCSTS frosted glassmorphism card"
  },
  "YCSTS KPI Stat Card": {
    "prefix": "yc-stat-card",
    "body": [
      "<div class=\"stat-card\">",
      "\t<div class=\"stat-label text-sm text-zinc-400\">${1:Total Revenue}</div>",
      "\t<div class=\"stat-value text-3xl font-bold text-zinc-100 mt-1\">${2:$45,280}</div>",
      "\t<div class=\"stat-trend text-xs font-semibold text-emerald-400 mt-2 flex items-center gap-1\">",
      "\t\t<span>&uarr; ${3:+18.2%}</span>",
      "\t\t<span class=\"text-zinc-500 font-normal\">vs last month</span>",
      "\t</div>",
      "</div>"
    ],
    "description": "YCSTS analytics KPI stat card with trend indicator"
  },
