  "YCSTS Button Radio": {
    "prefix": ["button-radio", "btn-radio", "yc-button-radio", "yc-btn-radio"],
    "body": [
      "<div class=\"inline-flex rounded-lg border border-zinc-700 p-1 bg-zinc-900/60\" role=\"radiogroup\">",
      "\t<label class=\"btn btn-sm ${1:btn-primary} cursor-pointer\">",
      "\t\t<input type=\"radio\" name=\"${2:radioGroup}\" class=\"sr-only\" checked>",
      "\t\t<span>${3:Option 1}</span>",
      "\t</label>",
      "\t<label class=\"btn btn-sm btn-ghost cursor-pointer text-zinc-400 hover:text-zinc-100\">",
      "\t\t<input type=\"radio\" name=\"${2:radioGroup}\" class=\"sr-only\">",
      "\t\t<span>${4:Option 2}</span>",
      "\t</label>",
      "</div>"
    ],
    "description": "YCSTS segmented radio button group"
