  "YCSTS Luxury Custom Select": {
    "prefix": "yc-custom-select",
    "body": [
      "<div class=\"custom-select\">",
      "\t<button type=\"button\" class=\"custom-select-trigger\">",
      "\t\t<span class=\"custom-select-value\">",
      "\t\t\t<span class=\"w-2.5 h-2.5 rounded-full bg-blue-500\"></span>",
      "\t\t\t<span>${1:Select an option}</span>",
      "\t\t</span>",
      "\t\t<svg class=\"custom-select-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\"/></svg>",
      "\t</button>",
      "\t<div class=\"custom-select-menu\">",
      "\t\t<div class=\"custom-select-search\">",
      "\t\t\t<input type=\"text\" placeholder=\"${2:Search...}\">",
      "\t\t</div>",
      "\t\t<div class=\"custom-select-options\">",
      "\t\t\t<div class=\"custom-select-group-label\">${3:Category}</div>",
      "\t\t\t<div class=\"custom-select-option is-selected\">",
      "\t\t\t\t<div class=\"option-title\">${4:Option One}</div>",
      "\t\t\t\t<div class=\"option-desc\">${5:Description text}</div>",
      "\t\t\t\t<svg class=\"option-check\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M20 6L9 17l-5-5\"/></svg>",
      "\t\t\t</div>",
      "\t\t\t<div class=\"custom-select-option\">",
      "\t\t\t\t<div class=\"option-title\">${6:Option Two}</div>",
      "\t\t\t\t<div class=\"option-desc\">${7:Another description}</div>",
      "\t\t\t</div>",
      "\t\t</div>",
      "\t</div>",
      "</div>"
    ],
    "description": "YCSTS luxury custom select dropdown with search and checkmark"
  },
  "YCSTS Enhanced Native Select": {
    "prefix": "yc-select-custom",
    "body": [
      "<select class=\"select-custom\">",
      "\t<option value=\"${1:val1}\">${2:Option 1}</option>",
      "\t<option value=\"${3:val2}\">${4:Option 2}</option>",
      "\t<option value=\"${5:val3}\">${6:Option 3}</option>",
      "</select>"
    ],
    "description": "YCSTS styled native select element"
  },
  "YCSTS Glowing Scrollbar Container": {
    "prefix": "yc-scrollbar-glow",
    "body": [
      "<div class=\"scrollbar-glow overflow-y-auto max-h-${1:64} p-${2:4} bg-zinc-900 border border-zinc-800 rounded-xl\">",
      "\t$0",
      "</div>"
    ],
    "description": "Container with glowing gradient custom scrollbar"
  },
  "YCSTS Radiant Text Selection": {
    "prefix": "yc-selection-glow",
