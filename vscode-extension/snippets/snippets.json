{
  "YCSTS Button A (Link)": {
    "prefix": ["button-a", "btn-a", "yc-button-a", "yc-btn-a"],
    "body": [
      "<a href=\"${1:#}\" class=\"btn ${2|btn-primary,btn-secondary,btn-gradient,btn-glow,btn-soft,btn-outline|}\" role=\"button\">${3:Link Button}</a>"
    ],
    "description": "YCSTS link styled as a button"
  },
  "YCSTS Button Block (Full Width)": {
    "prefix": ["button-block", "btn-block", "yc-button-block", "yc-btn-block"],
    "body": [
