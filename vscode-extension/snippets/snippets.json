  "YCSTS Class: modal": {
    "prefix": ["modal"],
    "body": "modal",
    "description": "Class: modal (Dialog box surface)"
  },
  "YCSTS Class: modal-overlay": {
    "prefix": ["modal-overlay"],
    "body": "modal-overlay",
    "description": "Class: modal-overlay (Full-screen backdrop blur)"
  },
  "YCSTS Element: Modal Default": {
    "prefix": ["modal-default", "modal-box", "yc-modal"],
    "body": [
      "<div class=\"modal-overlay\" id=\"${1:modal-id}\">",
      "\t<div class=\"modal\">",
      "\t\t<div class=\"modal-header\">",
      "\t\t\t<h3 class=\"text-lg font-semibold text-zinc-100\">${2:Modal Title}</h3>",
      "\t\t\t<button type=\"button\" class=\"modal-close\" onclick=\"document.getElementById('${1:modal-id}').classList.remove('is-active')\">&times;</button>",
      "\t\t</div>",
      "\t\t<div class=\"modal-body\">",
      "\t\t\t<p class=\"text-zinc-300\">${3:Modal dialog body text goes here.}</p>",
      "\t\t</div>",
      "\t\t<div class=\"modal-footer flex justify-end gap-3\">",
      "\t\t\t<button type=\"button\" class=\"btn btn-secondary\" onclick=\"document.getElementById('${1:modal-id}').classList.remove('is-active')\">Cancel</button>",
      "\t\t\t<button type=\"button\" class=\"btn btn-primary\">Confirm</button>",
      "\t\t</div>",
      "\t</div>",
      "</div>"
    ],
    "description": "Element: Modal dialog with backdrop and header/body/footer"
  },
  "YCSTS Element: Modal Confirm": {
    "prefix": ["modal-confirm", "yc-modal-confirm"],
    "body": [
      "<div class=\"modal-overlay\" id=\"${1:confirm-modal}\">",
      "\t<div class=\"modal max-w-sm text-center p-6 space-y-4\">",
      "\t\t<div class=\"w-12 h-12 rounded-full bg-red-500/10 text-red-500 mx-auto flex items-center justify-center text-xl font-bold\">!</div>",
      "\t\t<h3 class=\"text-lg font-bold text-zinc-100\">${2:Are you sure?}</h3>",
      "\t\t<p class=\"text-sm text-zinc-400\">${3:This action cannot be undone.}</p>",
      "\t\t<div class=\"flex justify-center gap-3 pt-2\">",
      "\t\t\t<button type=\"button\" class=\"btn btn-secondary\">Cancel</button>",
      "\t\t\t<button type=\"button\" class=\"btn btn-danger\">Delete</button>",
      "\t\t</div>",
      "\t</div>",
      "</div>"
    ],
    "description": "Element: Centered confirmation alert dialog"
  },
  "YCSTS Class: scrollbar-glow": {
    "prefix": ["scrollbar-glow", "scroll-glow"],
    "body": "scrollbar-glow",
    "description": "Class: scrollbar-glow (Gradient glowing scrollbar)"
  },
  "YCSTS Class: scrollbar-custom": {
    "prefix": ["scrollbar-custom", "scroll-custom"],
    "body": "scrollbar-custom",
    "description": "Class: scrollbar-custom (Clean slate scrollbar)"
  },
  "YCSTS Class: selection-glow": {
    "prefix": ["selection-glow"],
    "body": "selection-glow",
    "description": "Class: selection-glow (Radiant neon text selection)"
  },
  "YCSTS Class: badge": {
    "prefix": ["badge"],
    "body": "badge",
    "description": "Class: badge (Status pill badge)"
  },
  "YCSTS Class: toggle": {
    "prefix": ["toggle"],
    "body": "toggle",
    "description": "Class: toggle (Switch toggle input)"
  },
  "YCSTS Class: input": {
    "prefix": ["input"],
    "body": "input",
    "description": "Class: input (Styled form control)"
  },
  "YCSTS Element: Form Input Floating": {
    "prefix": ["form-input-floating", "input-floating", "yc-input-floating"],
    "body": [
      "<div class=\"relative\">",
      "\t<input type=\"${1|text,email,password|}\" id=\"${2:inputId}\" placeholder=\" \" class=\"input pt-6 pb-2 text-sm peer w-full\">",
      "\t<label for=\"${2:inputId}\" class=\"absolute text-xs text-zinc-500 duration-150 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-3 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 peer-focus:text-blue-500\">",
      "\t\t${3:Floating Label}",
      "\t</label>",
      "</div>"
    ],
    "description": "Element: Floating label animated input field"
  },
  "YCSTS Element: Form Toggle Switch": {
    "prefix": ["form-toggle", "toggle-box", "yc-toggle"],
    "body": [
      "<label class=\"flex items-center gap-3 cursor-pointer\">",
      "\t<input type=\"checkbox\" class=\"toggle\" ${1:checked}>",
      "\t<span class=\"text-sm text-zinc-300 font-medium\">${2:Enable feature}</span>",
      "</label>"
    ],
    "description": "Element: Custom toggle switch"
  },
  "YCSTS Element: Badge Status Live": {
    "prefix": ["badge-status-live", "badge-status", "yc-badge-status"],
    "body": [
      "<span class=\"badge badge-success flex items-center gap-1.5\">",
      "\t<span class=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\"></span>",
      "\t<span>${1:Operational}</span>",
      "</span>"
    ],
    "description": "Element: Status badge with active pulsing beacon"
  },
  "YCSTS Element: Navbar Default": {
    "prefix": ["navbar-default", "navbar", "nav-bar", "yc-navbar"],
    "body": [
      "<nav class=\"flex items-center justify-between px-6 py-4 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur-md sticky top-0 z-50\">",
      "\t<div class=\"flex items-center gap-6\">",
      "\t\t<a href=\"#\" class=\"text-xl font-bold text-zinc-100\">${1:Logo}</a>",
      "\t\t<div class=\"hidden md:flex items-center gap-4 text-sm text-zinc-400\">",
      "\t\t\t<a href=\"#\" class=\"text-zinc-100 font-medium\">Dashboard</a>",
      "\t\t\t<a href=\"#\" class=\"hover:text-zinc-100\">Features</a>",
      "\t\t\t<a href=\"#\" class=\"hover:text-zinc-100\">Docs</a>",
      "\t\t</div>",
      "\t</div>",
      "\t<div class=\"flex items-center gap-3\">",
      "\t\t<button type=\"button\" class=\"btn btn-primary btn-sm\">${2:Sign In}</button>",
      "\t</div>",
      "</nav>"
    ],
    "description": "Element: Responsive header navbar"
  },
  "YCSTS Element: Accordion Default": {
    "prefix": ["accordion-default", "accordion", "yc-accordion"],
    "body": [
      "<details class=\"accordion-item card p-4\" ${1:open}>",
      "\t<summary class=\"cursor-pointer font-semibold text-zinc-200 flex justify-between items-center\">",
      "\t\t<span>${2:Accordion Header Title}</span>",
      "\t\t<span class=\"accordion-arrow\">&darr;</span>",
      "\t</summary>",
      "\t<div class=\"accordion-content mt-3 text-sm text-zinc-400\">",
      "\t\t${3:Expanded detailed content information goes here.}",
      "\t</div>",
      "</details>"
    ],
    "description": "Element: Pure CSS disclosure accordion details element"
  },
  "YCSTS Element: Laravel Blade Directive": {
    "prefix": ["laravel-vite", "blade-vite", "yc-laravel-vite"],
    "body": [
      "@vite(['resources/css/app.css', 'resources/js/app.js'])"
    ],
    "description": "Directive: Laravel Vite asset directive"
  },
  "YCSTS Element: Laravel Blade Starter": {
    "prefix": ["laravel-starter", "blade-starter", "yc-blade-starter"],
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"{{ str_replace('_', '-', app()->getLocale()) }}\">",
      "<head>",
      "\t<meta charset=\"utf-8\">",
      "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
      "\t<title>${1:Laravel + YCSTS}</title>",
      "\t@vite(['resources/css/app.css', 'resources/js/app.js'])",
      "</head>",
      "<body class=\"bg-zinc-950 text-zinc-100 font-sans min-h-screen p-8 selection-glow\">",
      "\t<main class=\"max-w-4xl mx-auto space-y-6 fadein\">",
      "\t\t<header class=\"card-glass p-8 text-center\">",
      "\t\t\t<h1 class=\"text-4xl font-extrabold text-gradient-primary\">${2:Built with YCSTS}</h1>",
      "\t\t\t<p class=\"mt-3 text-zinc-400\">${3:Single-word entrance animations and luxury components in Laravel.}</p>",
      "\t\t\t<div class=\"mt-6 flex justify-center gap-3\">",
      "\t\t\t\t<button type=\"button\" class=\"btn btn-primary\">${4:Primary Action}</button>",
      "\t\t\t\t<button type=\"button\" class=\"btn btn-secondary\">${5:Secondary Action}</button>",
      "\t\t\t</div>",
      "\t\t</header>",
      "\t\t$0",
      "\t</main>",
      "</body>",
      "</html>"
    ],
    "description": "Template: Complete Laravel Blade starter layout with YCSTS and Vite"
  },
  "YCSTS CSS Import in app.css": {
    "prefix": ["import-ycsts", "import-css", "yc-import"],
    "body": [
      "@import \"ycsts-framework/dist/ycsts.min.css\";"
    ],
    "description": "Import: YCSTS minified CSS into CSS stylesheet"
  },
  "YCSTS Bundler Import": {
    "prefix": ["import-ycsts-bundler", "import-bundler", "yc-import-bundler"],
    "body": [
      "@import \"ycsts-framework\";"
    ],
    "description": "Import: Vite/Webpack direct bundle import for YCSTS"
  }
}
